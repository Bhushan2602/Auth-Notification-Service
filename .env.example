# Postgres
POSTGRES_USER=auth_admin
POSTGRES_PASSWORD=change-me-in-your-local-.env

# App DB
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/authdb

# JWT (Base64, 256-bit+) - generate your own, never commit the real one
JWT_SECRET=YXV0aC1wbGF0Zm9ybS1kZW1vLXNlY3JldC0yMDI2ISEhISEh

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
# Leave empty to run local-auth only; SecurityConfig enables Google login only when set.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# Mail (MailHog in docker; demo log otherwise)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_DEMO_LOG=true

# Frontend
FRONTEND_URL=http://localhost:5174
VITE_API_URL=http://localhost:8090/api
